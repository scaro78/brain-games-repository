# Set default behavior to automatically handle line endings
* text=auto

# Unity-specific text files (Force LF for cross-platform consistency)
*.cs diff=csharp text eol=lf
*.cginc text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf

# Unity YAML files (using Smart Merge if configured)
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.meta merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf

# --- Git LFS for 2D & Mobile Assets ---
# Textures and Sprites
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.spriteatlas filter=lfs diff=lfs merge=lfs -text

# Audio
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# Android & Build specific
*.apk filter=lfs diff=lfs merge=lfs -text
*.aab filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text
# --- Extras para Unity 2D ---
*.physicsMaterial2D text
*.spriteatlasv2 filter=lfs diff=lfs merge=lfs -text

# --- Fuentes de texto (UI) ---
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# --- Videos (si usas intros o cinemáticas) ---
*.mp4 filter=lfs diff=lfs merge=lfs -text

# --- Modelos 3D (a veces usados en entornos 2D) ---
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
